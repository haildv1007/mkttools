generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────
// Platform-level user role (NOT organization role)
// ──────────────────────────────────────────
enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

enum Platform {
  FACEBOOK
  TIKTOK
}

enum ContentType {
  IMAGE
  VIDEO
  TEXT
}

enum ContentStatus {
  DRAFT
  QUEUED
  GENERATING
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ContentSource {
  AI
  MANUAL
  IMPORT
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_EDIT
}

enum RevisionType {
  TEXT
  IMAGE
  VIDEO
  TEXT_AND_MEDIA
}

enum RevisionStatus {
  WAITING_FEEDBACK
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

// ──────────────────────────────────────────
// Organization roles
// ──────────────────────────────────────────
enum OrgRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum AccessMode {
  ALL
  RESTRICTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

// ──────────────────────────────────────────
// Core models
// ──────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ADMIN)
  telegramChatId String?  @map("telegram_chat_id")
  isPlatformAdmin Boolean @default(false) @map("is_platform_admin")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pages             Page[]
  campaigns         Campaign[]
  approvalLogs      ApprovalLog[]
  memberships       OrganizationMember[]

  @@map("users")
}

// ──────────────────────────────────────────
// Organization
// ──────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members       OrganizationMember[]
  pages         Page[]
  campaigns     Campaign[]
  contentItems  ContentItem[]
  workspaces    Workspace[]
  activityLogs  ActivityLog[]
  invitations   OrganizationInvitation[]
  aiCredentials OrganizationAiCredential[]
  aiSettings    OrganizationAiOperationSetting[]
  orgSettings   OrganizationSetting[]
  subscriptions OrganizationSubscription[]
  paymentOrders PaymentOrder[]

  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  userId         String     @map("user_id")
  role           OrgRole    @default(MEMBER)
  accessMode     AccessMode @default(ALL)
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  workspaceGrants OrganizationMemberWorkspace[]
  pageGrants      OrganizationMemberPage[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationMemberWorkspace {
  id       String @id @default(cuid())
  memberId String @map("member_id")
  workspaceId String @map("workspace_id")
  createdAt DateTime @default(now()) @map("created_at")

  member    OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([memberId, workspaceId])
  @@map("organization_member_workspaces")
}

model OrganizationMemberPage {
  id       String @id @default(cuid())
  memberId String @map("member_id")
  pageId   String @map("page_id")
  createdAt DateTime @default(now()) @map("created_at")

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  page   Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([memberId, pageId])
  @@map("organization_member_pages")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           OrgRole          @default(MEMBER)
  token          String           @unique @default(cuid())
  status         InvitationStatus @default(PENDING)
  invitedBy      String           @map("invited_by")
  expiresAt      DateTime         @map("expires_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([token])
  @@index([organizationId, email])
  @@map("organization_invitations")
}

// ──────────────────────────────────────────
// AI credentials & settings (org-scoped)
// ──────────────────────────────────────────

model OrganizationAiCredential {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  provider       String
  apiKey         String   @map("api_key")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider])
  @@map("organization_ai_credentials")
}

model OrganizationAiOperationSetting {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  operation      String
  provider       String
  model          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, operation])
  @@map("organization_ai_operation_settings")
}

// ──────────────────────────────────────────
// Organization settings (replaces global AppSetting for org-specific values)
// ──────────────────────────────────────────

model OrganizationSetting {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String
  value          String
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("organization_settings")
}

// ──────────────────────────────────────────
// Billing (org-scoped, structure only for isolation)
// ──────────────────────────────────────────

model OrganizationSubscription {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  plan           String   @default("free")
  status         String   @default("active")
  startDate      DateTime @default(now()) @map("start_date")
  endDate        DateTime? @map("end_date")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("organization_subscriptions")
}

model PaymentOrder {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  amount         Int
  currency       String   @default("VND")
  status         String   @default("pending")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  events       PaymentEvent[]

  @@index([organizationId])
  @@map("payment_orders")
}

model PaymentEvent {
  id           String   @id @default(cuid())
  orderId      String   @map("order_id")
  eventType    String   @map("event_type")
  payload      Json?
  createdAt    DateTime @default(now()) @map("created_at")

  order PaymentOrder @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payment_events")
}

// ──────────────────────────────────────────
// Existing models — now with organizationId
// ──────────────────────────────────────────

model Page {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  platform        Platform
  name            String
  externalId      String   @map("external_id")
  accessToken     String   @map("access_token")
  context         String?
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json?
  telegramGroupId String?  @map("telegram_group_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  campaigns      Campaign[]
  contentItems   ContentItem[]
  workspacePages WorkspacePage[]
  memberPageGrants OrganizationMemberPage[]

  @@unique([platform, externalId])
  @@index([organizationId])
  @@map("pages")
}

model Campaign {
  id            String    @id @default(cuid())
  organizationId String   @map("organization_id")
  name          String
  description   String?
  pageId        String    @map("page_id")
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  genLeadTime   Int       @default(30) @map("gen_lead_time")
  autoApprove   Boolean   @default(false) @map("auto_approve")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  page         Page          @relation(fields: [pageId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  contentItems ContentItem[]

  @@index([organizationId])
  @@map("campaigns")
}

model ContentItem {
  id                String        @id @default(cuid())
  organizationId    String        @map("organization_id")
  campaignId        String        @map("campaign_id")
  pageId            String        @map("page_id")
  scheduledAt       DateTime      @map("scheduled_at")
  topic             String
  notes             String?
  contentType       ContentType   @default(IMAGE) @map("content_type")
  aiModel           String?       @map("ai_model")
  aiImageModel      String?       @map("ai_image_model")
  generatedText     String?       @map("generated_text")
  generatedImageUrl String?       @map("generated_image_url")
  generatedImages   Json?         @map("generated_images")
  imageDescriptions String?       @map("image_descriptions")
  generatedVideoUrl String?       @map("generated_video_url")
  source            ContentSource @default(AI)
  status            ContentStatus @default(DRAFT)
  telegramMsgId     String?       @map("telegram_msg_id")
  socialPostId      String?       @map("social_post_id")
  publishedAt       DateTime?     @map("published_at")
  metrics           Json?
  retryCount        Int           @default(0) @map("retry_count")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  page             Page              @relation(fields: [pageId], references: [id])
  approvalLogs     ApprovalLog[]
  revisionSessions RevisionSession[]
  revisions        ContentRevision[]

  @@index([organizationId])
  @@index([status])
  @@index([scheduledAt])
  @@index([pageId, scheduledAt])
  @@map("content_items")
}

model ApprovalLog {
  id            String         @id @default(cuid())
  contentItemId String         @map("content_item_id")
  userId        String         @map("user_id")
  action        ApprovalAction
  feedback      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("approval_logs")
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String   @unique
  description    String?
  color          String?
  icon           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  workspacePages WorkspacePage[]
  memberWorkspaceGrants OrganizationMemberWorkspace[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspacePage {
  workspaceId String
  pageId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([workspaceId, pageId])
  @@index([workspaceId])
  @@index([pageId])
  @@map("workspace_pages")
}

model RevisionSession {
  id               String         @id @default(cuid())
  contentItemId    String         @map("content_item_id")
  chatId           String?        @map("chat_id")
  userId           String?        @map("user_id")
  sourceMessageId  Int?           @map("source_message_id")
  promptMessageId  Int?           @map("prompt_message_id")
  revisionType     RevisionType   @map("revision_type")
  selectedMediaIds Json?          @map("selected_media_ids")
  status           RevisionStatus @default(WAITING_FEEDBACK)
  feedbackText     String?        @map("feedback_text")
  source           String         @default("TELEGRAM")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  expiresAt        DateTime?      @map("expires_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@index([chatId, sourceMessageId])
  @@index([chatId, promptMessageId])
  @@index([contentItemId, status])
  @@map("revision_sessions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  action         String
  category       String
  status         String   @default("running")
  summary        String
  detail         String?
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  entityLabel    String?  @map("entity_label")
  progress       Int?
  total          Int?
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@map("activity_logs")
}

model ContentRevision {
  id              String      @id @default(cuid())
  contentItemId   String      @map("content_item_id")
  version         Int
  generatedText   String?     @map("generated_text")
  generatedImages Json?       @map("generated_images")
  feedback        String?
  source          String      @default("WEB")
  createdAt       DateTime    @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@unique([contentItemId, version])
  @@index([contentItemId])
  @@map("content_revisions")
}
