generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

enum Platform {
  FACEBOOK
  TIKTOK
}

enum ContentType {
  IMAGE
  VIDEO
  TEXT
}

enum ContentStatus {
  DRAFT
  GENERATING
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_EDIT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ADMIN)
  telegramChatId String?  @map("telegram_chat_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pages         Page[]
  campaigns     Campaign[]
  approvalLogs  ApprovalLog[]

  @@map("users")
}

model Page {
  id          String   @id @default(cuid())
  platform    Platform
  name        String
  externalId  String   @map("external_id")
  accessToken String   @map("access_token")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  contentItems ContentItem[]

  @@unique([platform, externalId])
  @@map("pages")
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive    Boolean   @default(true) @map("is_active")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  contentItems ContentItem[]

  @@map("campaigns")
}

model ContentItem {
  id               String        @id @default(cuid())
  campaignId       String        @map("campaign_id")
  pageId           String        @map("page_id")
  scheduledAt      DateTime      @map("scheduled_at")
  topic            String
  notes            String?
  contentType      ContentType   @default(IMAGE) @map("content_type")
  aiModel          String?       @map("ai_model")
  aiImageModel     String?       @map("ai_image_model")
  generatedText    String?       @map("generated_text")
  generatedImageUrl String?      @map("generated_image_url")
  generatedVideoUrl String?      @map("generated_video_url")
  status           ContentStatus @default(DRAFT)
  telegramMsgId    String?       @map("telegram_msg_id")
  socialPostId     String?       @map("social_post_id")
  publishedAt      DateTime?     @map("published_at")
  metrics          Json?
  retryCount       Int           @default(0) @map("retry_count")
  errorMessage     String?       @map("error_message")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  page         Page          @relation(fields: [pageId], references: [id])
  approvalLogs ApprovalLog[]

  @@index([status])
  @@index([scheduledAt])
  @@index([pageId, scheduledAt])
  @@map("content_items")
}

model ApprovalLog {
  id            String         @id @default(cuid())
  contentItemId String         @map("content_item_id")
  userId        String         @map("user_id")
  action        ApprovalAction
  feedback      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("approval_logs")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
