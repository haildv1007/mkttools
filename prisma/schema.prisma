generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

enum Platform {
  FACEBOOK
  TIKTOK
}

enum ContentType {
  IMAGE
  VIDEO
  TEXT
}

enum ContentStatus {
  DRAFT
  QUEUED
  GENERATING
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ContentSource {
  AI
  MANUAL
  IMPORT
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_EDIT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum OrgMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum OrgMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum MemberAccessMode {
  ALL
  RESTRICTED
}

enum AiCredentialSource {
  ORGANIZATION_KEY
  PERSONAL_KEY
  PLATFORM_API
}

enum AiCredentialValidation {
  UNTESTED
  CONNECTED
  INVALID
  ERROR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  passwordHash          String?   @map("password_hash")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  termsAcceptedAt       DateTime? @map("terms_accepted_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  role                  UserRole  @default(ADMIN)
  telegramChatId        String?   @map("telegram_chat_id")
  isActive              Boolean   @default(true) @map("is_active")
  isPlatformAdmin       Boolean   @default(false) @map("is_platform_admin")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  pages              Page[]
  campaigns          Campaign[]
  approvalLogs       ApprovalLog[]
  ownedOrganizations Organization[]        @relation("OrgOwner")
  memberships        OrganizationMember[]
  trialEntitlement   UserTrialEntitlement?
  authIdentities     UserAuthIdentity[]
  authTokens         AuthToken[]
  sessions           UserSession[]
  paymentOrders      PaymentOrder[]        @relation("PaymentOrderCreator")

  @@map("users")
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String?            @unique
  ownerUserId String?            @map("owner_user_id")
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  owner               User?                            @relation("OrgOwner", fields: [ownerUserId], references: [id])
  members             OrganizationMember[]
  pages               Page[]
  workspaces          Workspace[]
  campaigns           Campaign[]
  contentItems        ContentItem[]
  subscriptions       OrganizationSubscription[]
  aiCredentials       OrganizationAiCredential[]
  aiOperationSettings OrganizationAiOperationSetting[]
  settings            OrganizationSetting[]
  invitations         OrganizationInvitation[]
  paymentOrders       PaymentOrder[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrgMemberRole    @default(MEMBER)
  status         OrgMemberStatus  @default(ACTIVE)
  accessMode     MemberAccessMode @default(ALL) @map("access_mode")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceGrants OrganizationMemberWorkspace[]
  pageGrants      OrganizationMemberPage[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationMemberWorkspace {
  id                   String   @id @default(cuid())
  organizationMemberId String   @map("organization_member_id")
  workspaceId          String   @map("workspace_id")
  createdAt            DateTime @default(now()) @map("created_at")

  member    OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, workspaceId])
  @@index([workspaceId])
  @@map("organization_member_workspaces")
}

model OrganizationMemberPage {
  id                   String   @id @default(cuid())
  organizationMemberId String   @map("organization_member_id")
  pageId               String   @map("page_id")
  createdAt            DateTime @default(now()) @map("created_at")

  member OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)
  page   Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([organizationMemberId, pageId])
  @@index([pageId])
  @@map("organization_member_pages")
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  email           String
  role            OrgMemberRole    @default(MEMBER)
  accessMode      MemberAccessMode @default(ALL) @map("access_mode")
  invitedByUserId String?          @map("invited_by_user_id")
  tokenHash       String           @unique @map("token_hash")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at")
  acceptedAt      DateTime?        @map("accepted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

model OrganizationAiCredential {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  provider          String
  source            AiCredentialSource     @default(ORGANIZATION_KEY)
  encryptedApiKey   String                 @map("encrypted_api_key")
  defaultModel      String?                @map("default_model")
  config            Json?
  isActive          Boolean                @default(true) @map("is_active")
  validationStatus  AiCredentialValidation @default(UNTESTED) @map("validation_status")
  validationMessage String?                @map("validation_message")
  lastValidatedAt   DateTime?              @map("last_validated_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("organization_ai_credentials")
}

enum AiOperation {
  TEXT_GENERATION
  TEXT_REVISION
  IMAGE_GENERATION
  IMAGE_REVISION
  VIDEO_GENERATION
}

/**
 * Per-operation runtime AI selection. One provider credential (above) can
 * back different models for different operations (e.g. OpenAI "gpt-5" for
 * text, OpenAI "gpt-image-1" for images) — this table is the explicit,
 * customer-controlled source of truth generation reads first, before ever
 * falling back to a provider's defaultModel or a quality tier.
 */
model OrganizationAiOperationSetting {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  operation      AiOperation
  provider       String
  model          String
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, operation])
  @@map("organization_ai_operation_settings")
}

model SubscriptionPlan {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  maxPages   Int?     @map("max_pages")
  maxMembers Int?     @map("max_members")
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  subscriptions OrganizationSubscription[]
  prices        SubscriptionPlanPrice[]
  paymentOrders PaymentOrder[]

  @@map("subscription_plans")
}

model OrganizationSubscription {
  id               String             @id @default(cuid())
  organizationId   String             @map("organization_id")
  planId           String             @map("plan_id")
  status           SubscriptionStatus @default(ACTIVE)
  startedAt        DateTime           @default(now()) @map("started_at")
  expiresAt        DateTime?          @map("expires_at")
  customMaxPages   Int?               @map("custom_max_pages")
  customMaxMembers Int?               @map("custom_max_members")
  trialStartedAt   DateTime?          @map("trial_started_at")
  trialEndsAt      DateTime?          @map("trial_ends_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([organizationId, status])
  @@map("organization_subscriptions")
}

model TrialPolicy {
  id              String   @id @default(cuid())
  trialEnabled    Boolean  @default(true) @map("trial_enabled")
  trialDays       Int      @default(7) @map("trial_days")
  trialMaxPages   Int      @default(2) @map("trial_max_pages")
  trialMaxMembers Int      @default(2) @map("trial_max_members")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("trial_policy")
}

model UserTrialEntitlement {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  organizationId String   @map("organization_id")
  startedAt      DateTime @default(now()) @map("started_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_trial_entitlements")
}

model Page {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  platform        Platform
  name            String
  externalId      String   @map("external_id")
  accessToken     String   @map("access_token")
  context         String?
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json?
  telegramGroupId String?  @map("telegram_group_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user           User                     @relation(fields: [userId], references: [id])
  organization   Organization             @relation(fields: [organizationId], references: [id])
  campaigns      Campaign[]
  contentItems   ContentItem[]
  workspacePages WorkspacePage[]
  memberGrants   OrganizationMemberPage[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, isActive])
  @@map("pages")
}

model Campaign {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  description    String?
  pageId         String    @map("page_id")
  startDate      DateTime  @map("start_date")
  endDate        DateTime? @map("end_date")
  isActive       Boolean   @default(true) @map("is_active")
  genLeadTime    Int       @default(30) @map("gen_lead_time")
  autoApprove    Boolean   @default(false) @map("auto_approve")
  userId         String    @map("user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  page         Page          @relation(fields: [pageId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  contentItems ContentItem[]

  @@index([organizationId, isActive])
  @@map("campaigns")
}

model ContentItem {
  id                String        @id @default(cuid())
  organizationId    String        @map("organization_id")
  campaignId        String        @map("campaign_id")
  pageId            String        @map("page_id")
  scheduledAt       DateTime      @map("scheduled_at")
  topic             String
  notes             String?
  contentType       ContentType   @default(IMAGE) @map("content_type")
  aiModel           String?       @map("ai_model")
  aiImageModel      String?       @map("ai_image_model")
  generatedText     String?       @map("generated_text")
  generatedImageUrl String?       @map("generated_image_url")
  generatedImages   Json?         @map("generated_images")
  imageDescriptions String?       @map("image_descriptions")
  generatedVideoUrl String?       @map("generated_video_url")
  source            ContentSource @default(AI)
  status            ContentStatus @default(DRAFT)
  telegramMsgId     String?       @map("telegram_msg_id")
  socialPostId      String?       @map("social_post_id")
  publishedAt       DateTime?     @map("published_at")
  metrics           Json?
  retryCount        Int           @default(0) @map("retry_count")
  errorMessage      String?       @map("error_message")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  page             Page              @relation(fields: [pageId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  approvalLogs     ApprovalLog[]
  revisionSessions RevisionSession[]
  revisions        ContentRevision[]

  @@index([status])
  @@index([scheduledAt])
  @@index([pageId, scheduledAt])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("content_items")
}

model ApprovalLog {
  id            String         @id @default(cuid())
  contentItemId String         @map("content_item_id")
  userId        String         @map("user_id")
  action        ApprovalAction
  feedback      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("approval_logs")
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String   @unique
  description    String?
  color          String?
  icon           String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspacePages WorkspacePage[]
  memberGrants   OrganizationMemberWorkspace[]

  @@index([organizationId])
  @@map("workspaces")
}

model WorkspacePage {
  workspaceId String
  pageId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([workspaceId, pageId])
  @@index([workspaceId])
  @@index([pageId])
  @@map("workspace_pages")
}

enum RevisionType {
  TEXT
  IMAGE
  VIDEO
  TEXT_AND_MEDIA
}

enum RevisionStatus {
  WAITING_FEEDBACK
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

model RevisionSession {
  id               String         @id @default(cuid())
  contentItemId    String         @map("content_item_id")
  chatId           String?        @map("chat_id")
  userId           String?        @map("user_id")
  sourceMessageId  Int?           @map("source_message_id")
  promptMessageId  Int?           @map("prompt_message_id")
  revisionType     RevisionType   @map("revision_type")
  selectedMediaIds Json?          @map("selected_media_ids")
  status           RevisionStatus @default(WAITING_FEEDBACK)
  feedbackText     String?        @map("feedback_text")
  source           String         @default("TELEGRAM")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  expiresAt        DateTime?      @map("expires_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@index([chatId, sourceMessageId])
  @@index([chatId, promptMessageId])
  @@index([contentItemId, status])
  @@map("revision_sessions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/**
 * Customer-owned integration settings. These rows are strictly scoped to an
 * organization; AppSetting remains legacy/platform-global and must never be
 * exposed through normal customer APIs.
 */
model OrganizationSetting {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  key            String
  value          String
  isSecret       Boolean  @default(false) @map("is_secret")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

/**
 * Platform-global configuration (Platform Admin only) — distinct from
 * AppSetting (legacy, still used for Telegram/Facebook/timezone in the
 * per-install "Cài đặt hệ thống" page) and from OrganizationAiCredential
 * (org-scoped, customer BYOK). Secret values are AES-256-GCM encrypted with
 * PLATFORM_SECRET_KEY before being stored — `value` is never plaintext when
 * `isSecret` is true.
 */
model PlatformSetting {
  key       String   @id
  value     String?
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  action         String
  category       String
  status         String   @default("running")
  summary        String
  detail         String?
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  entityLabel    String?  @map("entity_label")
  progress       Int?
  total          Int?
  errorCode      String?  @map("error_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

model ContentRevision {
  id              String   @id @default(cuid())
  contentItemId   String   @map("content_item_id")
  version         Int
  generatedText   String?  @map("generated_text")
  generatedImages Json?    @map("generated_images")
  feedback        String?
  source          String   @default("WEB")
  createdAt       DateTime @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@unique([contentItemId, version])
  @@index([contentItemId])
  @@map("content_revisions")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN_CODE
}

model UserAuthIdentity {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  providerEmail  String?  @map("provider_email")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_auth_identities")
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model UserSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  FAILED
}

model SubscriptionPlanPrice {
  id            String   @id @default(cuid())
  planId        String   @map("plan_id")
  billingMonths Int      @map("billing_months")
  amount        Int
  currency      String   @default("VND")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  paymentOrders PaymentOrder[]

  @@unique([planId, billingMonths])
  @@map("subscription_plan_prices")
}

model PaymentOrder {
  id                    String             @id @default(cuid())
  organizationId        String             @map("organization_id")
  createdByUserId       String             @map("created_by_user_id")
  planId                String             @map("plan_id")
  planPriceId           String?            @map("plan_price_id")
  orderCode             String             @unique @map("order_code")
  status                PaymentOrderStatus @default(PENDING)
  amount                Int
  currency              String             @default("VND")
  billingMonths         Int                @map("billing_months")
  planCodeSnapshot      String             @map("plan_code_snapshot")
  planNameSnapshot      String             @map("plan_name_snapshot")
  provider              String?
  providerOrderId       String?            @map("provider_order_id")
  providerTransactionId String?            @map("provider_transaction_id")
  expiresAt             DateTime           @map("expires_at")
  paidAt                DateTime?          @map("paid_at")
  appliedAt             DateTime?          @map("applied_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [organizationId], references: [id])
  createdByUser User                   @relation("PaymentOrderCreator", fields: [createdByUserId], references: [id])
  plan          SubscriptionPlan       @relation(fields: [planId], references: [id])
  planPrice     SubscriptionPlanPrice? @relation(fields: [planPriceId], references: [id])
  events        PaymentEvent[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("payment_orders")
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentOrderId  String   @map("payment_order_id")
  provider        String
  externalEventId String   @map("external_event_id")
  eventType       String   @map("event_type")
  payload         Json?
  createdAt       DateTime @default(now()) @map("created_at")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@unique([provider, externalEventId])
  @@index([paymentOrderId])
  @@map("payment_events")
}
