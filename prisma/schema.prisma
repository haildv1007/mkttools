generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  VIEWER
}

enum Platform {
  FACEBOOK
  TIKTOK
}

enum ContentType {
  IMAGE
  VIDEO
  TEXT
}

enum ContentStatus {
  DRAFT
  GENERATING
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum ContentSource {
  AI
  MANUAL
  IMPORT
}

enum ApprovalAction {
  APPROVE
  REJECT
  REQUEST_EDIT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole @default(ADMIN)
  telegramChatId String?  @map("telegram_chat_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pages         Page[]
  campaigns     Campaign[]
  approvalLogs  ApprovalLog[]

  @@map("users")
}

model Page {
  id          String   @id @default(cuid())
  platform    Platform
  name        String
  externalId  String   @map("external_id")
  accessToken String   @map("access_token")
  context         String?
  isActive        Boolean  @default(true) @map("is_active")
  metadata        Json?
  telegramGroupId String?  @map("telegram_group_id")
  userId          String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  campaigns      Campaign[]
  contentItems   ContentItem[]
  workspacePages WorkspacePage[]

  @@unique([platform, externalId])
  @@map("pages")
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  pageId        String    @map("page_id")
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isActive      Boolean   @default(true) @map("is_active")
  genLeadTime   Int       @default(30) @map("gen_lead_time")
  autoApprove   Boolean   @default(false) @map("auto_approve")
  userId        String    @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  page         Page          @relation(fields: [pageId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  contentItems ContentItem[]

  @@map("campaigns")
}

model ContentItem {
  id               String        @id @default(cuid())
  campaignId       String        @map("campaign_id")
  pageId           String        @map("page_id")
  scheduledAt      DateTime      @map("scheduled_at")
  topic            String
  notes            String?
  contentType      ContentType   @default(IMAGE) @map("content_type")
  aiModel          String?       @map("ai_model")
  aiImageModel     String?       @map("ai_image_model")
  generatedText    String?       @map("generated_text")
  generatedImageUrl String?      @map("generated_image_url")
  generatedImages   Json?        @map("generated_images")
  imageDescriptions String?      @map("image_descriptions")
  generatedVideoUrl String?      @map("generated_video_url")
  source           ContentSource @default(AI)
  status           ContentStatus @default(DRAFT)
  telegramMsgId    String?       @map("telegram_msg_id")
  socialPostId     String?       @map("social_post_id")
  publishedAt      DateTime?     @map("published_at")
  metrics          Json?
  retryCount       Int           @default(0) @map("retry_count")
  errorMessage     String?       @map("error_message")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  page             Page              @relation(fields: [pageId], references: [id])
  approvalLogs     ApprovalLog[]
  revisionSessions RevisionSession[]

  @@index([status])
  @@index([scheduledAt])
  @@index([pageId, scheduledAt])
  @@map("content_items")
}

model ApprovalLog {
  id            String         @id @default(cuid())
  contentItemId String         @map("content_item_id")
  userId        String         @map("user_id")
  action        ApprovalAction
  feedback      String?
  createdAt     DateTime       @default(now()) @map("created_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@map("approval_logs")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String?
  icon        String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspacePages WorkspacePage[]

  @@map("workspaces")
}

model WorkspacePage {
  workspaceId String
  pageId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([workspaceId, pageId])
  @@index([workspaceId])
  @@index([pageId])
  @@map("workspace_pages")
}

enum RevisionType {
  TEXT
  IMAGE
  VIDEO
  TEXT_AND_MEDIA
}

enum RevisionStatus {
  WAITING_FEEDBACK
  PROCESSING
  COMPLETED
  CANCELLED
  EXPIRED
}

model RevisionSession {
  id               String         @id @default(cuid())
  contentItemId    String         @map("content_item_id")
  chatId           String?        @map("chat_id")
  userId           String?        @map("user_id")
  sourceMessageId  Int?           @map("source_message_id")
  promptMessageId  Int?           @map("prompt_message_id")
  revisionType     RevisionType   @map("revision_type")
  selectedMediaIds Json?          @map("selected_media_ids")
  status           RevisionStatus @default(WAITING_FEEDBACK)
  feedbackText     String?        @map("feedback_text")
  source           String         @default("TELEGRAM")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  expiresAt        DateTime?      @map("expires_at")

  contentItem ContentItem @relation(fields: [contentItemId], references: [id])

  @@index([chatId, sourceMessageId])
  @@index([chatId, promptMessageId])
  @@index([contentItemId, status])
  @@map("revision_sessions")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String
  category    String
  status      String   @default("running")
  summary     String
  detail      String?
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  entityLabel String?  @map("entity_label")
  progress    Int?
  total       Int?
  errorCode   String?  @map("error_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([category])
  @@index([status])
  @@map("activity_logs")
}
