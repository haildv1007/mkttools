# Facebook Graph API
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# TikTok (phase 2)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Server
PORT=3000
NODE_ENV=development

# Content settings
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
MAX_POSTS_PER_DAY_PER_PAGE=10
