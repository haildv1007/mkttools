# Database
DATABASE_URL="postgresql://mkttools:mkttools_secret@localhost:5432/mkttools"
DB_PASSWORD="mkttools_secret"

# Redis
REDIS_URL="redis://localhost:6379"

# AI Text Provider: claude | openai
AI_TEXT_PROVIDER="claude"
AI_TEXT_MODEL="claude-haiku-4-5-20251001"
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY=""

# AI Image Provider: replicate | dalle
AI_IMAGE_PROVIDER="replicate"
AI_IMAGE_MODEL="flux-schnell"
REPLICATE_API_KEY="r8_..."

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456:ABC..."
TELEGRAM_ADMIN_CHAT_IDS="123456789"

# Facebook Graph API
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Server
PORT=3000
NODE_ENV=development
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
JWT_SECRET="change-this-to-a-random-string-in-production"
LOG_LEVEL="info"

# Auth (M2.6)
JWT_SECRET=""            # required in production
APP_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""   # default: APP_URL/api/auth/google/callback
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="MKT Tools <no-reply@example.com>"
